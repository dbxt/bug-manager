[Unit]
Description=Bug Manager demo (static site on port 8430)
After=network.target

[Service]
WorkingDirectory=/home/dbaxter/sync/bug_manager
ExecStart=/usr/bin/python3 /home/dbaxter/sync/bug_manager/serve.py --host 0.0.0.0 --port 8430
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
